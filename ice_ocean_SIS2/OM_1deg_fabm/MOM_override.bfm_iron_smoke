! OM_1deg MOM6--SIS2--FABM--BFM (iron) configuration.
! The complete BFM initial-condition file supplies every active BFM state.
USE_FABM_TRACERS = True
FABM_CONFIG_FILE = "fabm_bfm_iron_9pft.yaml"
FABM_INITIAL_CONDITIONS_FILE = "INPUT/fabm_bfm_iron_copernicus_202501.nc"
FABM_INITIAL_CONDITIONS_ON_GRID = True

! Optical and atmospheric fallbacks used when the coupled driver does not
! provide the corresponding FABM environmental quantities.
FABM_LIGHT_ATTENUATION = 0.04
FABM_WIND_SPEED = 0.0
FABM_SURFACE_AIR_PRESSURE = 101325.0
FABM_ATMOSPHERIC_CO2 = 420.0
! Used only if the coupled driver does not supply SIS2 ice concentration.
FABM_ICE_AREA_FRACTION = 0.0
FABM_PROFILE_FIRST_CALL = True

! Exclude MOM6's contracted 1-mm layers from FABM. The substep bound catches
! unexpectedly large sinking CFLs instead of allowing an apparently stalled run.
FABM_CONTRACTED_LAYER_BUG = False
FABM_MINIMUM_ACTIVE_THICKNESS = 0.1
FABM_MAXIMUM_VERTICAL_SUBSTEPS = 100

! 91 iron-BFM states plus MOM6/SIS2 restart fields exceed the default (100).
MAX_FIELDS = 128
